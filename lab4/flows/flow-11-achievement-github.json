    {
      "parameters": {
        "jsCode": "// Получаем ответ от GitHub\nconst fileData = $input.first().json;\n\n// Проверяем, что файл получен\nif (fileData && fileData.content) {\n  // GitHub отдает контент в Base64. Декодируем его обратно в текст\n  // Buffer.from(..., 'base64') переводит из Base64 в байты\n  // .toString('utf-8') переводит байты в читаемый текст\n  const decodedContent = Buffer.from(fileData.content, 'base64').toString('utf-8');\n  \n  return {\n    json: {\n      status: \"success\",\n      message: \"Файл README.md успешно прочитан!\",\n      file_name: fileData.name,\n      // Берем первые 300 символов, чтобы не выводить весь текст в таблицу (иначе она растянется)\n      preview: decodedContent.substring(0, 300) + \"...\\n(текст обрезан для предпросмотра)\",\n      size_bytes: fileData.size\n    }\n  };\n} else {\n  return {\n    json: {\n      status: \"error\",\n      message: \"Не удалось прочитать файл или файл пуст\"\n    }\n  };\n}"
      },
