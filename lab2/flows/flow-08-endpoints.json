        "z": "fa407f2b8a7bb0b9",
        "name": "function 6",
        "func": "const id = Number(msg.req.query.id);\n\nconst items = {\n    1: \"Node-RED\",\n    2: \"MQTT\",\n    3: \"Dashboard\"\n};\n\nif (!msg.req.query.id) {\n    msg.statusCode = 400;\n    msg.payload = {\n        error: \"Parameter id is required\"\n    };\n} else if (!items[id]) {\n    msg.statusCode = 404;\n    msg.payload = {\n        error: \"Item not found\"\n    };\n} else {\n    msg.statusCode = 200;\n    msg.payload = {\n        id: id,\n        name: items[id]\n    };\n}\n\nreturn msg;",
